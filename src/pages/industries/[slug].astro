---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation';
import IndustryHeroSection from '../../components/IndustryHeroSection.astro';
import IndustryContent from '../../page-components/IndustryContent.tsx';
import CtaBlock from '../../components/CtaBlock.astro';
import ServiceLinks from '../../components/ServiceLinks.astro';
import Footer from '../../components/Footer';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { industries, getIndustryBySlug } from '../../data/industries';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { slug } = Astro.params;

// Which service page's suburb rotation and which blog posts each industry page links to.
const industryLinks: Record<string, { serviceSlug: string; posts: string[] }> = {
  "commercial": { serviceSlug: "strip-out-solutions", posts: ["make-good-strip-out-defit-melbourne", "office-strip-out", "patching-plastering-commercial-lease-handback"] },
  "industrial": { serviceSlug: "make-good-solutions/warehouse-make-good", posts: ["warehouse-factory-make-good-melbourne", "warehouse-demolition-mezzanine-cool-room-removal", "racking-removal-anchor-holes-lease-melbourne"] },
  "warehouses-logistics": { serviceSlug: "racking-solutions/pallet-racking-installation", posts: ["warehouse-floor-restoration-racking-removal", "car-park-repairs-line-marking-make-good", "racking-removal-anchor-holes-lease-melbourne"] },
  "retail": { serviceSlug: "make-good-solutions/flooring-reinstatement", posts: ["retail-make-good-melbourne-shopping-centre-tenants", "make-good-cost-drivers-melbourne"] },
  "medical-centres": { serviceSlug: "strip-out-solutions/make-safe", posts: ["medical-dental-clinic-make-good-melbourne", "electrical-make-safe-decommissioning-demolition"] },
  "hospitality-venues": { serviceSlug: "handover-solutions/end-of-lease-cleaning", posts: ["restaurant-cafe-make-good-melbourne", "end-of-lease-cleaning-services"] },
};
const industry = getIndustryBySlug(slug);

if (!industry) {
  return Astro.redirect('/');
}

// JSON-LD, rendered server-side here rather than via the React component's
// Helmet (which is a no-op shim, see src/lib/helmet.ts) so this actually
// reaches the page.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": industry.title,
  "description": industry.metaDescription,
  "provider": {
    "@type": "LocalBusiness",
    "name": "MakeGOOD Melbourne",
    "url": "https://makegood.melbourne"
  },
  "areaServed": {
    "@type": "City",
    "name": "Melbourne"
  }
};

const faqSchema = industry.faqs && industry.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": industry.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---

<BaseLayout
  title={industry.metaTitle}
  description={industry.metaDescription}
  ogImage={industry.ogImage || "/og-default.jpg"}
  canonicalUrl={`https://makegood.melbourne/industries/${industry.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <main class="min-h-screen bg-background text-foreground">
    <Navigation client:load />
    
    <!-- Breadcrumbs (using shared component) -->
    <div class="pt-24 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto">
        <Breadcrumbs path={`/industries/${slug}/`} />
      </div>
    </div>
    
    <!-- Static optimized hero section -->
    <IndustryHeroSection slug={slug} />
    
    <!-- Interactive content loaded after hero -->
    <IndustryContent slug={slug} client:idle />
    
    <!-- Blog posts and suburbs for this industry, same block as the service pages -->
    <ServiceLinks
      serviceSlug={industryLinks[slug]?.serviceSlug ?? 'make-good-solutions'}
      serviceName={industry.name}
      postSlugs={industryLinks[slug]?.posts}
    />

    <!-- Standardized CTA Block (an industry can set its own closing heading and text) -->
    {industry.ctaTitle
      ? <CtaBlock custom={{ title: industry.ctaTitle, subtitle: industry.ctaSubtitle, text: industry.ctaText ?? '' }} />
      : <CtaBlock />}
    
    <Footer client:idle />
  </main>
</BaseLayout>
