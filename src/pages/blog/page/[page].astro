---
// Blog pagination pages: /blog/page/2/ onwards. Page 1 lives at /blog/.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BlogPage, { getBlogPageCount, POSTS_PER_PAGE } from '../../../page-components/Blog.tsx';
import { blogPosts } from '../../../data/blogPosts';
import { sortBlogPostsByDate } from '../../../lib/blogUtils';

export function getStaticPaths() {
  const total = getBlogPageCount();
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const page = Number(Astro.params.page);

// Each page gets its own description by naming the first post on it, so pages 2, 3, 4...
// aren't near duplicates of each other.
const firstPost = sortBlogPostsByDate(blogPosts)[(page - 1) * POSTS_PER_PAGE];
const pageDescription = `Page ${page} of the MakeGOOD Melbourne blog: make good, strip out and remediation guides, starting with ${firstPost ? `"${firstPost.title}"` : 'older posts'}.`;
---

<BaseLayout
  title={`Blog, Page ${page} | MakeGOOD Melbourne`}
  description={pageDescription}
  canonicalUrl={`https://makegood.melbourne/blog/page/${page}/`}
>
  <Navigation client:load />
  <div class="bg-secondary pt-20">
    <Breadcrumbs path="/blog/" />
  </div>
  <BlogPage page={page} />
</BaseLayout>
