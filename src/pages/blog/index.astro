---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogPage from '../../page-components/Blog.tsx';
import { buildImageVariants } from '@/lib/imageVariants';
import { getBlogPageImages } from '../../page-components/Blog.tsx';
const imageVariants = await buildImageVariants(getBlogPageImages(1));
---

<BaseLayout 
  title="Blog: Make Good Guides & Advice | MakeGOOD Melbourne"
  description="Expert insights on commercial property restoration, end of lease requirements and make good best practices from the people who do the work."
  canonicalUrl="https://makegood.melbourne/blog/"
>
  <Navigation client:load />
  <div class="bg-secondary pt-20">
    <Breadcrumbs path="/blog/" />
  </div>
  <BlogPage page={1} imageVariants={imageVariants} />
</BaseLayout>
