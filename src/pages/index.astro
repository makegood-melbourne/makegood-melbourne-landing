---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation';
import HeroSection from '../components/HeroSection.astro';
import TrustStrip from '../components/TrustStrip.astro';
import TermsExplainer from '../components/TermsExplainer.astro';
import SpecialistsSection from '../components/SpecialistsSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import IndexContent from '../components/IndexContent';
import FAQ from '../components/FAQ.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Footer from '../components/Footer';
import { homepageFaqs } from '../data/faqs';

// Generate FAQPage schema from homepage FAQs
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homepageFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

// Suburbs we feature on the homepage, reused for areaServed
const featuredAreas = [
  "Melbourne CBD", "Port Melbourne", "Richmond", "Moorabbin", "Ringwood",
  "Dandenong", "Dandenong South", "Clayton", "Mulgrave", "Hallam", "Braeside",
];

const serviceCatalog = [
  { name: "Strip Out Solutions", url: "https://makegood.melbourne/services/strip-out-solutions/" },
  { name: "Make Good Solutions", url: "https://makegood.melbourne/services/make-good-solutions/" },
  { name: "Handover Solutions", url: "https://makegood.melbourne/services/handover-solutions/" },
  { name: "Remediation Solutions", url: "https://makegood.melbourne/services/remediation-solutions/" },
  { name: "Roofing Solutions", url: "https://makegood.melbourne/services/roofing-solutions/" },
];

// LocalBusiness schema (service area business: suburb level address only, no street address)
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "additionalType": "https://schema.org/HomeAndConstructionBusiness",
  "@id": "https://makegood.melbourne/#localbusiness",
  "name": "MakeGOOD Melbourne",
  "alternateName": "Make Good Melbourne",
  "url": "https://makegood.melbourne/",
  "logo": "https://makegood.melbourne/makegood-melbourne-logo.png",
  "image": [
    "https://makegood.melbourne/og-default.jpg",
    "https://makegood.melbourne/images/commercial-property-restoration-capabilities-melbourne.jpg"
  ],
  "email": "info@makegood.melbourne",
  "description": "Commercial make good, strip out, remediation and roofing for offices, warehouses and industrial properties across Melbourne. Free site inspection and fixed price quotes.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Melbourne",
    "addressRegion": "VIC",
    "addressCountry": "AU"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "info@makegood.melbourne",
    "contactType": "customer service",
    "areaServed": "AU-VIC",
    "availableLanguage": "English"
  },
  "areaServed": [
    { "@type": "State", "name": "Victoria" },
    { "@type": "City", "name": "Melbourne" },
    ...featuredAreas.map((name) => ({ "@type": "Place", "name": `${name}, Victoria` })),
  ],
  "serviceType": [
    "Make Good Services",
    "End of Lease Restoration",
    "Office Strip Outs",
    "Warehouse Restoration",
    "Building Remediation",
    "Make Safe Services",
    "Commercial Roofing",
    "Commercial Property Restoration"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Commercial make good, strip out, remediation and roofing services",
    "itemListElement": serviceCatalog.map((service) => ({
      "@type": "Offer",
      "itemOffered": { "@type": "Service", "name": service.name, "url": service.url }
    }))
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://makegood.melbourne/#organization",
  "name": "MakeGOOD Melbourne",
  "alternateName": "Make Good Melbourne",
  "url": "https://makegood.melbourne/",
  "logo": "https://makegood.melbourne/makegood-melbourne-logo.png",
  "email": "info@makegood.melbourne"
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://makegood.melbourne/#website",
  "name": "MakeGOOD Melbourne",
  "alternateName": "Make Good Melbourne",
  "url": "https://makegood.melbourne/",
  "inLanguage": "en-AU",
  "publisher": { "@id": "https://makegood.melbourne/#organization" }
};
---

<BaseLayout 
  title="Commercial Make Good & Strip Out Melbourne | MakeGOOD Melbourne"
  description="End of lease make good, strip out, remediation and roofing for Melbourne offices, warehouses and industrial sites. Free site inspection and fixed price quote."
  ogImage="/og/commercial.jpg"
  canonicalUrl="https://makegood.melbourne/"
>
  <!-- JSON-LD Schemas -->
  <Fragment slot="head">
    <!-- Homepage only: keep the floating quote button and chat launcher out of the way until the visitor scrolls,
         so they never cover the hero buttons or the trust strip. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function update() { root.classList.toggle('hero-in-view', window.scrollY < 300); }
        update();
        window.addEventListener('scroll', update, { passive: true });
      })();
    </script>
    <style is:global>
      .hero-in-view .floating-cta,
      .hero-in-view .chat-launcher {
        opacity: 0;
        pointer-events: none;
        transform: translateY(12px);
      }
      .floating-cta, .chat-launcher { transition: opacity 0.25s ease, transform 0.25s ease; }
    </style>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>

  <main class="min-h-screen bg-background text-foreground">
    <Navigation client:load />
    <HeroSection />
    <TrustStrip />
    <SpecialistsSection />
    <ServicesGrid />
    <TermsExplainer />
    <IndexContent client:idle />
    <FAQ />
    <CtaBlock bg="bg-muted/30" />
    <Footer client:load />
  </main>
</BaseLayout>
