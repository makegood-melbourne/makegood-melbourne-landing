---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactPage from '../page-components/Contact.tsx';
---

<BaseLayout
  showFloatingCta={false} 
  title="Contact Us | MakeGOOD Melbourne"
  description="Get a free quote for your make good project. Send the site address and your lease end date, and we'll book a free site visit."
  canonicalUrl="https://makegood.melbourne/contact/"
>
  <Navigation client:load />
  <div class="bg-secondary pt-20">
    <Breadcrumbs path="/contact/" />
  </div>
  <ContactPage client:load />
</BaseLayout>
