---
/**
 * Services Index Page
 *
 * Central hub for all six service categories. The tile grid is the shared
 * ServicesGrid component, so it always matches the homepage exactly.
 * Sections: hero, lease lifecycle, service tiles, "where to start" helper,
 * FAQs (with FAQPage schema) and CTA.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import Footer from '../../components/Footer';
import { Image } from 'astro:assets';

import servicesHero from "@/assets/images/hero/warehouse-steel-truss-commercial-services-melbourne.webp";
import servicesHeroMobile from "@/assets/images/hero/warehouse-steel-truss-commercial-services-melbourne-mobile.webp";

// One contractor across the whole lease: move in, during, move out
const leaseStages = [
  {
    stage: 'MOVING IN',
    title: 'Set the warehouse up',
    text: 'Racking laid out around how you pick, a slab that can take it and aisles marked before the first delivery.',
    links: [
      { label: 'Pallet Racking Installation', href: '/services/racking-solutions/pallet-racking-installation/' },
      { label: 'Racking Relocation', href: '/services/racking-solutions/racking-relocation-reconfiguration/' },
      { label: 'Warehouse Flooring', href: '/services/make-good-solutions/warehouse-flooring/' },
      { label: 'Line Marking', href: '/services/make-good-solutions/line-marking/' },
    ],
  },
  {
    stage: 'DURING THE LEASE',
    title: 'Keep the building working',
    text: 'Leaks, storm damage, failed waterproofing and structural defects fixed at the source, before they become your problem at lease end.',
    links: [
      { label: 'Roofing Solutions', href: '/services/roofing-solutions/' },
      { label: 'Remediation Solutions', href: '/services/remediation-solutions/' },
      { label: 'Racking Reconfiguration', href: '/services/racking-solutions/racking-relocation-reconfiguration/' },
    ],
  },
  {
    stage: 'MOVING OUT',
    title: 'Hand the keys back',
    text: 'Fitout out, racking down, anchor holes filled, walls and floors restored and the site cleaned for the landlord\'s inspection.',
    links: [
      { label: 'Strip Out Solutions', href: '/services/strip-out-solutions/' },
      { label: 'Make Good Solutions', href: '/services/make-good-solutions/' },
      { label: 'Handover Solutions', href: '/services/handover-solutions/' },
      { label: 'Pallet Racking Removal', href: '/services/strip-out-solutions/pallet-racking-removal/' },
    ],
  },
];

// Situation-led routing for visitors who don't know the service name
const startPoints = [
  { situation: 'My lease is ending', answer: 'Make good works to return the space to the condition the lease asks for.', label: 'Make Good Solutions', href: '/services/make-good-solutions/' },
  { situation: 'There is a fitout to remove', answer: 'Partitions, ceilings, offices and fixtures stripped back to base building.', label: 'Strip Out Solutions', href: '/services/strip-out-solutions/' },
  { situation: 'We are moving into a warehouse', answer: 'Racking, slab repairs and line marking so you are ready to ship.', label: 'Fulfilment Warehouse Fit Out', href: '/industries/warehouses-logistics/' },
  { situation: 'The roof is leaking', answer: 'Leak repairs, box gutters, sheets and skylights on commercial and warehouse roofs.', label: 'Roofing Solutions', href: '/services/roofing-solutions/' },
  { situation: 'The building has a defect', answer: 'Structural repairs, waterproofing, water damage and cladding compliance.', label: 'Remediation Solutions', href: '/services/remediation-solutions/' },
  { situation: 'Handover is days away', answer: 'End of lease cleaning and relocation so the keys go back on time.', label: 'Handover Solutions', href: '/services/handover-solutions/' },
];

const faqs = [
  {
    question: 'What is the difference between a make good and a strip out?',
    answer: 'A strip out removes the fitout: partitions, ceilings, joinery and fixtures. A make good is everything needed to return the space to the condition the lease asks for, which usually includes the strip out plus patching, painting, flooring, ceilings and cleaning.',
  },
  {
    question: 'Do you handle the whole project or just specific trades?',
    answer: 'The whole project. Demolition, electrical, plumbing, painting, flooring, roofing, racking and cleaning are all coordinated through one point of contact. You deal with us, we deal with everyone else.',
  },
  {
    question: 'Can different services go in one quote?',
    answer: 'Yes, and most projects need more than one. A warehouse exit might be racking removal, slab repairs, a roof leak and a handover clean. We scope it once and give you one fixed price.',
  },
  {
    question: 'What types of properties do you work on?',
    answer: 'Commercial and industrial only. Offices, retail, warehouses, fulfilment centres, factories and showrooms across Melbourne.',
  },
  {
    question: 'Do you give fixed price quotes?',
    answer: 'Yes. We visit the site, review the lease or the problem and quote a fixed price for the agreed scope. No surprises later.',
  },
  {
    question: 'How do I know which service I need?',
    answer: 'Tell us what is happening, whether the lease is ending, you are moving in or something is leaking, and we will scope it. Send a few photos and the address and we will take it from there.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  })),
};
---

<BaseLayout
  title="Make Good & Property Services Melbourne | MakeGOOD Melbourne"
  description="All our services: make good, strip out, remediation, roofing, racking and handover for Melbourne warehouses, offices and industrial sites."
  canonicalUrl="https://makegood.melbourne/services/"
  ogImage="/og/services.jpg"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen flex flex-col bg-background">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary"
    >
      Skip to main content
    </a>

    <Navigation client:idle />

    <div class="bg-secondary pt-20">
      <Breadcrumbs path="/services/" />
    </div>

    <main id="main-content" class="flex-1">
      <!-- Hero -->
      <section class="bg-secondary pt-4 pb-10 md:pt-6 md:pb-12">
        <div class="container mx-auto px-4">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <h1 class="services-hero__heading">
                Commercial Make Good &amp;<br />
                Property Services<br />
                <span class="services-hero__accent">Melbourne</span>
              </h1>
              <div class="lg:hidden mb-6">
                <Image
                  src={servicesHeroMobile}
                  alt="Steel roof trusses and skylights in a large empty Melbourne warehouse ready for make good, racking and roofing works"
                  class="aspect-[4/3] w-full object-cover rounded-lg"
                  width={1200}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 1023px) 100vw, 1px"
                  loading="eager"
                  fetchpriority="high"
                  quality={60}
                />
              </div>
              <p class="services-hero__copy">
                Strip outs, make goods, remediation, roofing, racking and handover for offices, warehouses and industrial sites. Six services, every trade, one contractor. From the day you get the keys to the day you hand them back.
              </p>
              <div class="flex flex-col sm:flex-row gap-4">
                <a href="/contact/" class="inline-flex items-center justify-center px-6 py-3 bg-primary hover:bg-primary/90 text-primary-foreground font-medium rounded-md transition-colors">
                  Request a Quote
                </a>
                <a href="mailto:info@makegood.melbourne" class="inline-flex items-center justify-center px-6 py-3 border border-accent text-accent hover:bg-accent hover:text-accent-foreground font-medium rounded-md transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  Email Us
                </a>
              </div>
            </div>
            <div class="hidden lg:block">
              <Image
                src={servicesHero}
                alt="Steel roof trusses and skylights in a large empty Melbourne warehouse ready for make good, racking and roofing works"
                class="aspect-[4/3] w-full object-cover rounded-lg"
                width={1200}
                widths={[400, 800, 1200]}
                sizes="(max-width: 1023px) 1px, 600px"
                loading="eager"
                fetchpriority="high"
                quality={60}
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Lease lifecycle -->
      <section class="py-14 md:py-16 bg-background">
        <div class="container mx-auto px-4 max-w-6xl">
          <div class="text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">ONE CONTRACTOR. <span class="text-primary">THE WHOLE LEASE.</span></h2>
            <p class="text-lg text-muted-foreground max-w-3xl mx-auto">Most contractors turn up for one part of a lease. We cover all of it, so nothing falls between trades and nobody has to start from scratch.</p>
          </div>
          <div class="grid md:grid-cols-3 gap-6">
            {leaseStages.map((s) => (
              <div class="rounded-lg border border-border bg-card p-6 border-t-4 border-t-primary/70">
                <p class="text-xs font-bold tracking-widest text-primary mb-2">{s.stage}</p>
                <h3 class="text-xl font-bold text-foreground mb-3">{s.title}</h3>
                <p class="text-muted-foreground leading-relaxed mb-5">{s.text}</p>
                <ul class="space-y-2">
                  {s.links.map((l) => (
                    <li>
                      <a href={l.href} class="inline-flex items-center text-sm font-medium text-foreground hover:text-primary transition-colors">
                        <span class="text-primary mr-2">→</span>{l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Service tiles: shared with the homepage -->
      <ServicesGrid />

      <!-- Where to start -->
      <section class="py-14 md:py-16 bg-background">
        <div class="container mx-auto px-4 max-w-6xl">
          <div class="text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">NOT SURE <span class="text-primary">WHERE TO START?</span></h2>
            <p class="text-lg text-muted-foreground">Start with what's happening. We'll work out the rest.</p>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            {startPoints.map((p) => (
              <a href={p.href} class="group block rounded-lg border border-border bg-card p-5 transition-colors hover:border-primary/50">
                <h3 class="text-lg font-semibold text-foreground mb-2">{p.situation}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed mb-3">{p.answer}</p>
                <span class="text-sm font-medium text-primary group-hover:underline">{p.label} →</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- FAQs -->
      <section class="py-12 md:py-16 bg-secondary">
        <div class="container mx-auto px-4 max-w-4xl">
          <div class="text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-4">COMMON QUESTIONS</h2>
          </div>
          <div class="space-y-4">
            {faqs.map((f) => (
              <details class="faq-item bg-background border border-border rounded-lg px-6 group">
                <summary class="faq-question text-left text-lg font-medium hover:text-primary py-5 cursor-pointer list-none flex items-center justify-between">
                  <span>{f.question}</span>
                  <svg class="faq-chevron h-5 w-5 shrink-0 transition-transform duration-200 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="faq-answer text-muted-foreground text-base pb-5 leading-relaxed">{f.answer}</div>
              </details>
            ))}
          </div>
          <div class="text-center mt-10">
            <a href="/faq/" class="inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-11 px-8">
              More Questions? See Our FAQ
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </section>

      <div class="cta-wrapper">
        <CtaBlock />
      </div>
    </main>

    <Footer client:idle />
  </div>
</BaseLayout>

<style>
  .services-hero__heading {
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: #ffffff;
    margin-bottom: 12px;
  }
  .services-hero__accent {
    color: #F28C3A;
  }
  .services-hero__copy {
    font-size: 18px;
    line-height: 1.6;
    color: #ffffff;
    margin-bottom: 32px;
  }
  @media (max-width: 600px) {
    .services-hero__copy {
      font-size: 16px;
    }
  }
  details[open] .faq-chevron {
    transform: rotate(180deg);
  }
  details[open] {
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .cta-wrapper :global(section) {
    background-color: hsl(0 0% 25% / 0.3);
  }
</style>
