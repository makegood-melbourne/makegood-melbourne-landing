---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TermsOfServicePage from '../page-components/TermsOfService.tsx';
---

<BaseLayout 
  title="Terms of Service | MakeGOOD Melbourne"
  description="The terms that apply when you use the MakeGOOD Melbourne website and engage us for make good, strip out or other commercial works."
  canonicalUrl="https://makegood.melbourne/terms-of-service/"
>
  <Navigation client:load />
  <div class="bg-secondary pt-20">
    <Breadcrumbs path="/terms-of-service/" />
  </div>
  <TermsOfServicePage client:idle />
</BaseLayout>
