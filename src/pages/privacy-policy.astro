---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PrivacyPolicyPage from '../page-components/PrivacyPolicy.tsx';
---

<BaseLayout 
  title="Privacy Policy | MakeGOOD Melbourne"
  description="How MakeGOOD Melbourne collects, uses, stores and protects the personal information you send us through this website and our services."
  canonicalUrl="https://makegood.melbourne/privacy-policy/"
>
  <Navigation client:load />
  <div class="bg-secondary pt-20">
    <Breadcrumbs path="/privacy-policy/" />
  </div>
  <PrivacyPolicyPage client:idle />
</BaseLayout>
