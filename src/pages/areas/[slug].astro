---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation';
import LocationHeroSection from '../../components/LocationHeroSection.astro';
import LocationContent from '../../page-components/LocationContent.tsx';
import CtaBlock from '../../components/CtaBlock.astro';
import QuickQuoteForm from '../../components/QuickQuoteForm';
import Footer from '../../components/Footer';
import NearbyAreas from '../../components/NearbyAreas.astro';
import { locations, getLocationBySlug } from '../../data/locations';
import { buildImageVariants } from '@/lib/imageVariants';
import { locationContentImages } from '../../page-components/LocationContent.tsx';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { slug } = Astro.params;
const location = getLocationBySlug(slug);

if (!location) {
  return Astro.redirect('/service-areas/');
}

// JSON-LD, rendered server-side here rather than via the React component's
// Helmet (which is a no-op shim, see src/lib/helmet.ts) so this actually
// reaches the page.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `Make Good Services ${location.name}`,
  "description": location.metaDescription,
  "provider": { "@type": "LocalBusiness", "name": "MakeGOOD Melbourne", "url": "https://makegood.melbourne" },
  "areaServed": { "@type": "City", "name": location.name, "containedIn": "Victoria, Australia" },
  "serviceType": "Make Good Services"
};

const faqSchema = location.faqs && location.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": location.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
} : null;
const imageVariants = await buildImageVariants(locationContentImages);

// Core warehouse suburbs (where most clients are) get the short quote form instead of the
// generic call to action, so people can ask for a price without leaving the page.
const CORE_SUBURBS = ['clayton', 'mulgrave', 'dandenong-south', 'hallam'];
const showQuickQuote = CORE_SUBURBS.includes(slug ?? '');
---

<BaseLayout
  title={location.metaTitle}
  description={location.metaDescription}
  ogImage="/og/locations-default.jpg"
  canonicalUrl={`https://makegood.melbourne/areas/${location.slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <Navigation client:load />
  
  <!-- Static optimized hero section with breadcrumbs -->
  <LocationHeroSection slug={slug} />
  
  <!-- Interactive content loaded after hero -->
  <LocationContent slug={slug} imageVariants={imageVariants} client:idle />
  
  <!-- Standardized CTA Block -->
  <NearbyAreas slug={slug} name={location.name} />

  {showQuickQuote ? (
    <section class="py-12 md:py-16 bg-secondary">
      <div class="container mx-auto px-4">
        <QuickQuoteForm
          client:visible
          sourcePage={`/areas/${slug}/`}
          suburb={location.name}
          heading={`Get a fixed price for your ${location.name} make good`}
        />
      </div>
    </section>
  ) : (
    <CtaBlock />
  )}
  
  <Footer client:idle />
</BaseLayout>
