---
// End of page links on service and category pages: the blog posts written about
// this service and a rotating set of suburbs where this work is common.
import { getPostsForService, getAreasForService } from '@/data/internalLinks';
import { getPublishedServices } from '@/data/services';

interface Props {
  serviceSlug: string;
  serviceName: string;
}

const { serviceSlug, serviceName } = Astro.props;
const categorySlugs = [
  'make-good-solutions', 'strip-out-solutions', 'remediation-solutions',
  'roofing-solutions', 'handover-solutions', 'racking-solutions',
];
const allServiceSlugs = [...getPublishedServices().map((service) => service.slug), ...categorySlugs];
const posts = getPostsForService(serviceSlug);
const areas = getAreasForService(serviceSlug, allServiceSlugs);
---

<section class="py-16 bg-background border-t border-border">
  <div class="container mx-auto px-4 max-w-6xl grid gap-12 lg:grid-cols-2">
    {posts.length > 0 && (
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-6 uppercase">
          From the <span class="text-primary">blog</span>
        </h2>
        <ul class="space-y-3">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.slug}/`} class="text-lg text-foreground underline underline-offset-4 decoration-border hover:text-primary hover:decoration-primary transition-colors">
                {post.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    <div class={posts.length > 0 ? '' : 'lg:col-span-2'}>
      <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-6 uppercase">
        {serviceName} <span class="text-primary">near you</span>
      </h2>
      <ul class="flex flex-wrap gap-3">
        {areas.map((area) => (
          <li>
            <a
              href={`/areas/${area.slug}/`}
              class="inline-block rounded-full border border-border bg-card px-4 py-2 text-foreground hover:border-primary/50 hover:text-primary transition-colors"
            >
              {area.name}
            </a>
          </li>
        ))}
        <li>
          <a href="/service-areas/" class="inline-block rounded-full px-4 py-2 text-primary underline underline-offset-4">All areas</a>
        </li>
      </ul>
    </div>
  </div>
</section>
