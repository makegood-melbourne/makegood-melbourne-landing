---
// Homepage "Recent projects" strip. Grey placeholders until Ali supplies job photos.
// When photos arrive: import each image, add it to the project and swap the
// placeholder div for an astro:assets <Image> with loading="lazy".
const projects = [
  { suburb: '[Suburb]', caption: '[One line on the scope, e.g. racking removal, slab repairs and line marking]', href: '/services/make-good-solutions/warehouse-make-good/' },
  { suburb: '[Suburb]', caption: '[One line on the scope]', href: '/services/make-good-solutions/warehouse-make-good/' },
  { suburb: '[Suburb]', caption: '[One line on the scope]', href: '/services/make-good-solutions/warehouse-make-good/' },
];
---

<section class="py-16 md:py-20 bg-background">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl md:text-5xl font-bold mb-5 text-center">
      RECENT <span class="text-primary">PROJECTS</span>
    </h2>
    <p class="text-xl text-white/90 text-center max-w-3xl mx-auto mb-10 leading-relaxed">
      Real jobs, handed back on time. Most of our work is in Melbourne's south east warehouse belt.
    </p>
    <div class="grid gap-6 md:grid-cols-3">
      {projects.map((project) => (
        <a href={project.href} class="group block rounded-lg border border-border bg-card overflow-hidden hover:border-primary/50 transition-colors">
          <div class="aspect-[4/3] bg-muted flex items-center justify-center p-4 text-center">
            <span class="text-sm text-muted-foreground">[Job photo to come]</span>
          </div>
          <div class="p-5">
            <p class="text-lg font-semibold text-foreground">{project.suburb}</p>
            <p class="text-muted-foreground">{project.caption}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
