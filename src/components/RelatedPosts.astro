---
// "Related posts" block at the end of every blog post. Plain server rendered
// links, three posts from the same topic.
import { getRelatedPosts } from '@/data/internalLinks';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const related = getRelatedPosts(slug);
---

{related.length > 0 && (
  <section class="py-16 bg-secondary" aria-labelledby="related-posts-heading">
    <div class="container mx-auto px-4 max-w-6xl">
      <h2 id="related-posts-heading" class="text-3xl md:text-4xl font-bold text-foreground mb-8 uppercase">
        Related <span class="text-primary">posts</span>
      </h2>
      <div class="grid gap-6 md:grid-cols-3">
        {related.map((post) => (
          <a
            href={`/blog/${post.slug}/`}
            class="group block rounded-lg border border-border bg-background p-6 hover:border-primary/50 transition-colors"
          >
            <h3 class="text-xl font-semibold text-foreground mb-2 group-hover:text-primary transition-colors">{post.title}</h3>
            {post.subtitle && <p class="text-primary font-medium mb-3">{post.subtitle}</p>}
            <p class="text-muted-foreground line-clamp-3">{post.excerpt}</p>
          </a>
        ))}
      </div>
      <p class="mt-8">
        <a href="/blog/" class="text-primary underline underline-offset-4 hover:text-primary/80">All posts</a>
      </p>
    </div>
  </section>
)}
